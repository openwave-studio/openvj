// Layouts: the whole-window views picked from the LAYOUT menu at the left of the
// top bar, as in openDJ. Mixer is the full mixing screen; Player and Synthesis are
// lighter screens over the same running show.
import { Theme, CloseIcon } from "theme.slint";
import { ScrollView } from "std-widgets.slint";
import { Chevron, FlatButton, BlendPicker } from "controls.slint";

export global Layouts {
    // Order matches the menu and Cmd/Ctrl+1, 2, 3.
    out property <[string]> names: ["Mixer", "Player", "Synthesis"];
    out property <int> mixer: 0;
    out property <int> player: 1;
    out property <int> synthesis: 2;
}

/// Outline icon for a layout, in openDJ's style: a rounded frame with a hint of
/// what the layout shows inside.
export component LayoutIcon inherits Path {
    in property <int> layout;
    in property <color> color: Theme.text;
    width: 24px;
    height: 16px;
    viewbox-width: 24;
    viewbox-height: 16;
    stroke: root.color;
    stroke-width: 1.6px;
    fill: transparent;
    // Mixer: a grid of clip cells. Player: a big picture with a playlist beside it.
    // Synthesis: three faders.
    commands: "M 3 1 L 21 1 Q 23 1 23 3 L 23 13 Q 23 15 21 15 L 3 15 Q 1 15 1 13 L 1 3 Q 1 1 3 1 Z "
        + (root.layout == 0 ? "M 5 5 L 8 5 M 10.5 5 L 13.5 5 M 16 5 L 19 5 M 5 11 L 8 11 M 10.5 11 L 13.5 11 M 16 11 L 19 11"
        : root.layout == 1 ? "M 5 4.5 L 11 4.5 L 11 11.5 L 5 11.5 Z M 14 5 L 19 5 M 14 8 L 19 8 M 14 11 L 17 11"
        : "M 7 4 L 7 12 M 12 4 L 12 12 M 17 4 L 17 12 M 5.5 9 L 8.5 9 M 10.5 6 L 13.5 6 M 15.5 10 L 18.5 10");
}

component Check inherits Path {
    width: 12px;
    height: 9px;
    viewbox-width: 12;
    viewbox-height: 9;
    commands: "M 1 4.5 L 4.5 8 L 11 1";
    stroke: Theme.accent;
    stroke-width: 1.6px;
    fill: transparent;
}

/// The LAYOUT menu button: the current layout's icon and name; click opens the menu.
export component LayoutPicker inherits Rectangle {
    in property <int> current;
    callback picked(int);

    width: row.preferred-width;
    border-radius: Theme.radius;
    background: ta.pressed ? Theme.pressed : ta.has-hover ? #1d1d20 : Theme.panel-2;
    border-width: 1px;
    border-color: Theme.border;

    row := HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        spacing: 8px;
        LayoutIcon {
            layout: root.current;
            y: (parent.height - self.height) / 2;
        }
        Text {
            text: Layouts.names[root.current];
            color: Theme.text;
            font-size: Theme.font-normal;
            font-weight: 600;
            vertical-alignment: center;
        }
        Chevron {
            y: (parent.height - self.height) / 2;
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { popup.show(); }
    }

    popup := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: 200px;
        Rectangle {
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: 10px;
            drop-shadow-blur: 16px;
            drop-shadow-color: #000000b0;
            VerticalLayout {
                padding: 8px;
                spacing: 2px;
                Text {
                    height: 26px;
                    x: 10px;
                    text: "LAYOUT";
                    color: Theme.text-dim;
                    font-size: Theme.font-small;
                    font-weight: 600;
                    letter-spacing: 0.8px;
                    vertical-alignment: center;
                }
                for name[i] in Layouts.names: Rectangle {
                    height: 34px;
                    border-radius: Theme.radius;
                    background: item-ta.has-hover ? Theme.raised : transparent;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 12px;
                        spacing: 12px;
                        LayoutIcon {
                            layout: i;
                            y: (parent.height - self.height) / 2;
                            color: i == root.current ? Theme.accent : Theme.text;
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: name;
                            color: i == root.current ? Theme.accent : Theme.text;
                            font-size: Theme.font-normal;
                            font-weight: i == root.current ? 600 : 400;
                            vertical-alignment: center;
                        }
                        if i == root.current: Check {
                            y: (parent.height - self.height) / 2;
                        }
                    }
                    item-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.picked(i); }
                    }
                }
            }
        }
    }
}

/// Stand-in for a layout that isn't built yet: the output, large, with a note.
export component LayoutPlaceholder inherits Rectangle {
    in property <int> layout;
    in property <image> output-image;

    background: Theme.bg;
    VerticalLayout {
        padding: 24px;
        spacing: 16px;
        alignment: center;
        Rectangle {
            vertical-stretch: 1;
            max-height: 540px;
            Image {
                width: parent.width;
                height: parent.height;
                source: root.output-image;
                image-fit: contain;
            }
        }
        Text {
            text: root.layout == Layouts.player
                ? "Player is coming: a playlist of presets that plays by itself and follows the music."
                : "Synthesis is coming: one layer at a time, laid out like a synth, with macros to play live.";
            color: Theme.text-dim;
            font-size: Theme.font-normal;
            horizontal-alignment: center;
        }
        Text {
            text: "Switch back to Mixer with Cmd+1 (Ctrl+1) or the LAYOUT menu.";
            color: Theme.text-faint;
            font-size: Theme.font-body;
            horizontal-alignment: center;
        }
    }
}

/// One preset row in the Player's playlist.
export struct PresetRow {
    name: string,
    // Source kind for the colour tag ("gen", "video", ...), see Theme.kind-color.
    kind: string,
    // Index into the play-for choices.
    play-for: int,
    current: bool,
}

/// openDJ's labelled picker: LABEL value ▾, opening a menu that can have headings.
/// `headings[i]`, when not empty, is shown above item i.
export component LabeledPicker inherits Rectangle {
    in property <string> label;
    in property <[string]> items;
    in property <[string]> headings;
    in property <int> current;
    callback picked(int);

    height: 32px;
    border-radius: Theme.radius;
    background: ta.has-hover ? #1d1d20 : Theme.panel-2;
    border-width: 1px;
    border-color: Theme.border;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        Text {
            text: root.label;
            color: Theme.text-dim;
            font-size: Theme.font-small;
            font-weight: 600;
            letter-spacing: 0.6px;
            vertical-alignment: center;
        }
        Text {
            horizontal-stretch: 1;
            text: root.items[root.current];
            color: Theme.text;
            font-size: Theme.font-normal;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }
        Chevron {
            y: (parent.height - self.height) / 2;
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { popup.show(); }
    }

    popup := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: max(root.width, 200px);
        Rectangle {
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: 10px;
            drop-shadow-blur: 16px;
            drop-shadow-color: #000000b0;
            VerticalLayout {
                padding: 6px;
                for item[i] in root.items: VerticalLayout {
                    if root.headings[i] != "": Text {
                        height: 26px;
                        x: 10px;
                        text: root.headings[i];
                        color: Theme.text-dim;
                        font-size: Theme.font-small;
                        font-weight: 600;
                        letter-spacing: 0.8px;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        height: 30px;
                        border-radius: Theme.radius;
                        background: i == root.current ? Theme.accent.with-alpha(0.3) : item-ta.has-hover ? Theme.raised : transparent;
                        Text {
                            x: 16px;
                            text: item;
                            color: Theme.text;
                            font-size: Theme.font-normal;
                            font-weight: i == root.current ? 600 : 400;
                            vertical-alignment: center;
                        }
                        item-ta := TouchArea {
                            clicked => { root.picked(i); }
                        }
                    }
                }
            }
        }
    }
}

component RowIcon inherits Rectangle {
    in property <string> text;
    callback clicked();
    width: 22px;
    height: 22px;
    border-radius: Theme.radius-small;
    background: ta.has-hover ? Theme.raised : transparent;
    Text {
        text: root.text;
        color: ta.has-hover ? Theme.text : Theme.text-dim;
        font-size: Theme.font-body;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// The Player layout: the output, large, beside an Automix panel in openDJ's style.
export component PlayerLayout inherits Rectangle {
    in property <image> output-image;
    in property <string> playlist-name;
    in property <string> info;
    in property <[PresetRow]> rows;
    in property <bool> live;
    in property <[string]> length-names;
    in property <[string]> length-headings;
    in property <int> length;
    in property <[string]> style-names;
    in property <int> style;
    in property <[string]> play-names;
    in property <bool> shuffle;
    in property <bool> repeat;
    // The clip selected in the Mixer, which "Add" puts in the playlist ("" if none).
    in property <string> selected-clip;
    callback toggle();
    callback next();
    callback add-selected();
    callback remove(int);
    callback move(int, int);
    callback play-for(int, int);
    callback length-picked(int);
    callback style-picked(int);
    callback shuffle-toggled();
    callback repeat-toggled();
    callback open();
    callback save();
    callback new();

    background: Theme.bg;
    HorizontalLayout {
        padding: 8px;
        spacing: 8px;

        Rectangle {
            horizontal-stretch: 1;
            background: Theme.track;
            border-radius: Theme.radius;
            Image {
                width: parent.width;
                height: parent.height;
                source: root.output-image;
                image-fit: contain;
            }
            if !root.live: Text {
                y: parent.height - 40px;
                text: root.rows.length == 0
                    ? "Select a clip in Mixer, then Add it here or use Add to playlist in its Clip tab."
                    : "Press AUTOMIX to play the playlist.";
                color: Theme.text-dim;
                font-size: Theme.font-normal;
            }
        }

        Rectangle {
            width: 420px;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.separator;
            border-radius: Theme.radius;
            VerticalLayout {
                padding: 12px;
                spacing: 10px;

                HorizontalLayout {
                    spacing: 10px;
                    Text {
                        text: "Automix";
                        color: Theme.text;
                        font-size: Theme.font-xl;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: root.info;
                        color: Theme.text-dim;
                        font-size: Theme.font-normal;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Rectangle {
                        width: 120px;
                        height: 34px;
                        border-radius: 17px;
                        background: root.live ? Theme.accent.with-alpha(0.2) : go-ta.has-hover ? Theme.raised : Theme.panel-2;
                        border-width: 1px;
                        border-color: root.rows.length > 0 ? Theme.accent : Theme.border;
                        opacity: root.rows.length > 0 ? 1 : 0.5;
                        Text {
                            text: root.live ? "■  STOP" : "▶  AUTOMIX";
                            color: root.rows.length > 0 ? Theme.accent : Theme.text-dim;
                            font-size: Theme.font-normal;
                            font-weight: 700;
                        }
                        go-ta := TouchArea {
                            enabled: root.rows.length > 0;
                            mouse-cursor: pointer;
                            clicked => { root.toggle(); }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    LabeledPicker {
                        horizontal-stretch: 1;
                        label: "LENGTH";
                        items: root.length-names;
                        headings: root.length-headings;
                        current: root.length;
                        picked(i) => { root.length-picked(i); }
                    }
                    LabeledPicker {
                        horizontal-stretch: 1;
                        label: "STYLE";
                        items: root.style-names;
                        headings: [];
                        current: root.style;
                        picked(i) => { root.style-picked(i); }
                    }
                }

                HorizontalLayout {
                    spacing: 6px;
                    FlatButton {
                        text: "Shuffle";
                        active: root.shuffle;
                        clicked => { root.shuffle-toggled(); }
                    }
                    FlatButton {
                        text: "Repeat";
                        active: root.repeat;
                        clicked => { root.repeat-toggled(); }
                    }
                    FlatButton {
                        text: "Next ▸▸";
                        enabled: root.live;
                        clicked => { root.next(); }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                }

                Rectangle {
                    height: 1px;
                    background: Theme.separator;
                }

                Text {
                    text: root.playlist-name == "" ? "PLAYLIST" : "PLAYLIST · " + root.playlist-name;
                    color: Theme.text-dim;
                    font-size: Theme.font-small;
                    font-weight: 600;
                    letter-spacing: 0.6px;
                    overflow: elide;
                }

                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        alignment: start;
                        spacing: 2px;
                        for row[i] in root.rows: Rectangle {
                            height: 36px;
                            border-radius: Theme.radius;
                            background: row.current ? Theme.accent.with-alpha(0.14) : row-ta.has-hover ? Theme.raised : transparent;
                            border-width: row.current ? 1px : 0;
                            border-color: Theme.accent;
                            row-ta := TouchArea { }
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 6px;
                                spacing: 8px;
                                Text {
                                    width: 18px;
                                    text: i + 1;
                                    color: Theme.text-faint;
                                    font-size: Theme.font-body;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }
                                Rectangle {
                                    width: 4px;
                                    height: 18px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 2px;
                                    background: Theme.kind-color(row.kind);
                                }
                                Text {
                                    horizontal-stretch: 1;
                                    text: row.name;
                                    color: row.current ? Theme.accent : Theme.text;
                                    font-size: Theme.font-normal;
                                    font-weight: row.current ? 600 : 400;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                BlendPicker {
                                    width: 84px;
                                    y: (parent.height - self.height) / 2;
                                    modes: root.play-names;
                                    current: row.play-for;
                                    menu-width: 120px;
                                    picked(k) => { root.play-for(i, k); }
                                }
                                RowIcon {
                                    y: (parent.height - self.height) / 2;
                                    text: "↑";
                                    clicked => { root.move(i, i - 1); }
                                }
                                RowIcon {
                                    y: (parent.height - self.height) / 2;
                                    text: "↓";
                                    clicked => { root.move(i, i + 1); }
                                }
                                Rectangle {
                                    width: 22px;
                                    height: 22px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: Theme.radius-small;
                                    background: x-ta.has-hover ? Theme.raised : transparent;
                                    CloseIcon {
                                        size: 8px;
                                    }
                                    x-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.remove(i); }
                                    }
                                }
                            }
                        }
                    }
                }

                FlatButton {
                    height: 30px;
                    text: root.selected-clip == "" ? "+ Add (select a clip in Mixer first)" : "+ Add " + root.selected-clip;
                    enabled: root.selected-clip != "";
                    clicked => { root.add-selected(); }
                }
                HorizontalLayout {
                    spacing: 6px;
                    FlatButton {
                        horizontal-stretch: 1;
                        text: "New";
                        clicked => { root.new(); }
                    }
                    FlatButton {
                        horizontal-stretch: 1;
                        text: "Open playlist…";
                        clicked => { root.open(); }
                    }
                    FlatButton {
                        horizontal-stretch: 1;
                        text: "Save playlist…";
                        clicked => { root.save(); }
                    }
                }
            }
        }
    }
}
