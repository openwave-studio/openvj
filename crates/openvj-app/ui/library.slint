// The library browser: every generator, effect, MilkDrop preset and saved preset as a
// grid of thumbnails (or a list), with search, view chips and filters. Used by the
// Sources and Effects tabs of the browser. See openspec/changes/add-library-browser.

import { ListView } from "std-widgets.slint";
import { Theme, CloseIcon } from "theme.slint";
import { FlatButton } from "controls.slint";
import { LibTile, LibChip, LibSideRow } from "state.slint";
import { DragSource } from "drag.slint";

/// Colour of a library kind badge.
export global LibKinds {
    public pure function color(kind: string) -> color {
        if (kind == "GEN") { return Theme.gen; }
        if (kind == "MD") { return Theme.syphon; }
        if (kind == "PRE") { return Theme.video; }
        if (kind == "FX") { return Theme.link; }
        return Theme.text-faint;
    }
}

/// Five bars, lit up to the intensity (0 calm … 5 peak); all dark when unset (-1).
export component IntensityBars inherits HorizontalLayout {
    in property <int> value: -1;
    in property <length> unit: 2px;
    spacing: 2px;
    alignment: end;
    for i in 5: Rectangle {
        y: parent.height - self.height;
        width: 3px;
        height: root.unit * (i + 2);
        border-radius: 1px;
        background: i < root.value ? Theme.accent : Theme.border;
    }
}

/// A rounded filter chip: a label and a count, the active one in the accent.
export component Chip inherits Rectangle {
    in property <string> text;
    in property <string> count;
    in property <bool> active;
    in property <color> tint: Theme.accent;
    callback clicked();
    height: 22px;
    min-width: row.preferred-width + 14px;
    border-radius: 11px;
    background: root.active ? root.tint.with-alpha(0.16) : ta.has-hover ? Theme.raised : Theme.panel-2;
    border-width: 1px;
    border-color: root.active ? root.tint : Theme.border;
    row := HorizontalLayout {
        alignment: center;
        spacing: 5px;
        Text {
            text: root.text;
            color: root.active ? root.tint : Theme.text;
            font-size: Theme.font-body;
            vertical-alignment: center;
        }
        if root.count != "": Text {
            text: root.count;
            color: Theme.text-dim;
            font-size: Theme.font-small;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// One item in the grid: thumbnail, kind badge, star, name, audio-reactive mark and
/// intensity bars.
component Tile inherits Rectangle {
    in property <LibTile> tile;
    // Position in `Lib.tiles`, for dragging.
    in property <int> index;
    callback clicked();
    callback double-clicked();
    border-radius: Theme.radius-small;
    background: Theme.panel-2;
    border-width: 1px;
    border-color: tile.selected ? Theme.accent : ta.has-hover ? Theme.border : Theme.separator;
    opacity: tile.unwanted ? 0.55 : 1;
    VerticalLayout {
        padding: 1px;
        // Kept square: a rounded clip over an image renders black on femtovg-wgpu.
        Rectangle {
            height: (root.width - 2px) * 9 / 16;
            background: Theme.track;
            if tile.has-thumb: Image {
                width: parent.width;
                height: parent.height;
                source: tile.thumb;
                image-fit: cover;
            }
            if !tile.has-thumb: Text {
                text: tile.name;
                color: Theme.text-faint;
                font-size: Theme.font-small;
                horizontal-alignment: center;
                vertical-alignment: center;
                wrap: word-wrap;
                width: parent.width - 12px;
            }
            Rectangle {
                x: 4px;
                y: 4px;
                width: badge.preferred-width + 6px;
                height: 12px;
                border-radius: 2px;
                background: LibKinds.color(tile.kind);
                badge := Text {
                    text: tile.kind;
                    color: #000;
                    font-size: 8px;
                    font-weight: 800;
                }
            }
            if tile.favorite: Text {
                x: parent.width - self.width - 5px;
                y: 2px;
                text: "★";
                color: Theme.tempo;
                font-size: 12px;
            }
            if tile.selected: Rectangle {
                x: parent.width - self.width - 4px;
                y: parent.height - self.height - 4px;
                width: sel-label.preferred-width + 8px;
                height: 13px;
                border-radius: 2px;
                background: Theme.accent;
                sel-label := Text {
                    text: "IN PREVIEW";
                    color: Theme.on-accent;
                    font-size: 8px;
                    font-weight: 700;
                }
            }
        }
        HorizontalLayout {
            height: 22px;
            padding-left: 6px;
            padding-right: 6px;
            spacing: 5px;
            Text {
                horizontal-stretch: 1;
                text: tile.name;
                color: Theme.text;
                font-size: Theme.font-body;
                overflow: elide;
                vertical-alignment: center;
            }
            if tile.reactive: Text {
                text: "♪";
                color: Theme.audio;
                font-size: Theme.font-body;
                vertical-alignment: center;
            }
            IntensityBars {
                padding-bottom: 6px;
                value: tile.intensity;
            }
        }
    }
    DragSource {
        kind: tile.kind == "FX" ? "effect" : "source";
        item: "lib:" + root.index;
        label: tile.name;
        thumb: tile.has-thumb ? tile.thumb : @image-url("");
        ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.clicked(); }
            double-clicked => { root.double-clicked(); }
        }
    }
}

/// One item in the list view.
component Row inherits Rectangle {
    in property <LibTile> tile;
    in property <int> index;
    in property <bool> odd;
    callback clicked();
    callback double-clicked();
    height: 26px;
    border-radius: Theme.radius-small;
    background: tile.selected ? Theme.accent-dim : ta.has-hover ? Theme.raised : odd ? #161819 : transparent;
    opacity: tile.unwanted ? 0.55 : 1;
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 8px;
        spacing: 8px;
        Rectangle {
            width: 30px;
            height: 14px;
            y: (parent.height - self.height) / 2;
            border-radius: 3px;
            background: LibKinds.color(tile.kind);
            Text {
                text: tile.kind;
                color: #000;
                font-size: 8px;
                font-weight: 800;
            }
        }
        Text {
            width: 12px;
            text: tile.favorite ? "★" : "";
            color: Theme.tempo;
            vertical-alignment: center;
        }
        Text {
            horizontal-stretch: 1;
            text: tile.name;
            color: Theme.text;
            font-size: 12px;
            overflow: elide;
            vertical-alignment: center;
        }
        Text {
            horizontal-stretch: 0;
            max-width: 180px;
            text: tile.detail;
            color: Theme.text-faint;
            font-size: Theme.font-small;
            overflow: elide;
            vertical-alignment: center;
        }
        Text {
            width: 12px;
            text: tile.reactive ? "♪" : "";
            color: Theme.audio;
            vertical-alignment: center;
        }
        IntensityBars {
            padding-top: 6px;
            padding-bottom: 7px;
            value: tile.intensity;
        }
    }
    DragSource {
        kind: tile.kind == "FX" ? "effect" : "source";
        item: "lib:" + root.index;
        label: tile.name;
        thumb: tile.has-thumb ? tile.thumb : @image-url("");
        ta := TouchArea {
            clicked => { root.clicked(); }
            double-clicked => { root.double-clicked(); }
        }
    }
}

/// The library's state and actions, set and handled by the app (src/app.rs).
export global Lib {
    in property <[LibTile]> tiles;
    in property <[LibChip]> chips;
    in property <string> count;
    in property <string> empty-hint;
    // Kind filter: 0 all, then the labels in `kind-names`.
    in property <[string]> kind-names: ["All kinds"];
    in-out property <int> kind;
    // Intensity filter: 0 any, 1 calm (0–1), 2 medium (2–3), 3 peak (4–5).
    in-out property <int> intensity;
    in-out property <bool> reactive;
    in-out property <bool> list-view;
    // 0 small … 2 large.
    in-out property <int> tile-size: 0;
    in-out property <string> search;
    // Goes up by one when the search box should take the keyboard.
    in property <int> focus-search;
    // The selected tile, -1 for none.
    in property <int> selected: -1;
    in property <string> selected-name;
    in property <int> selected-intensity: -1;
    in property <bool> selected-favorite;
    in property <bool> selected-unwanted;
    in property <bool> selected-kept;
    in property <string> place-label: "Put in slot";
    // The expanded library over the clip grid (Tab).
    in property <bool> expanded;
    in property <[LibSideRow]> side-rows;
    in property <string> selected-detail;
    in property <string> selected-usage;
    in property <[string]> selected-tags;
    in property <[string]> selected-crates;
    in property <bool> selected-is-effect;

    callback tile-clicked(int);
    callback tile-double-clicked(int);
    callback chip-clicked(int);
    callback filters-changed();
    callback rows-shown(int, int);
    // Returns true when the library handled the key.
    callback key(string) -> bool;
    callback set-intensity(int);
    callback toggle-favorite();
    callback set-kept(bool);
    callback set-unwanted(bool);
    callback place();
    // 0 clip, 1 layer, 2 group, 3 composition.
    callback effect-add(int);
    callback use-preview-thumbnail();
    // Esc with nothing left to clear: the grid gives the keyboard back.
    callback done();
    callback toggle-expanded();
    callback side-clicked(int);
    callback add-tag(string);
    callback remove-tag(int);
    callback add-to-crate(string);
    callback remove-from-crate(int);
    callback add-to-playlist();
}

/// The library panel: search, chips, filters, grid, and a bar for the selected item.
export component LibraryPanel inherits FocusScope {
    in property <bool> is-effects;
    in property <bool> clip-selected;
    in property <bool> group-selected;
    // The expanded view: bigger tiles, the chips live in the sidebar, the info panel
    // replaces the selection bar.
    in property <bool> large;

    property <int> focus-search: Lib.focus-search;
    changed focus-search => {
        search-input.focus();
        search-input.set-selection-offsets(Lib.search.character-count, Lib.search.character-count);
    }

    property <length> tile-min: (Lib.tile-size == 0 ? 96px : Lib.tile-size == 1 ? 132px : 190px) + (root.large ? 60px : 0px);
    property <int> columns: max(1, floor((grid.width - 12px + 6px) / (root.tile-min + 6px)));
    property <length> tile-w: (grid.width - 12px - (root.columns - 1) * 6px) / root.columns;
    property <length> row-h: root.tile-w * 9 / 16 + 30px;

    key-pressed(e) => {
        if (Lib.key(e.text)) {
            return accept;
        }
        return reject;
    }

    VerticalLayout {
        spacing: 6px;

        // Search, count, grid or list, tile size.
        HorizontalLayout {
            spacing: 6px;
            height: 28px;
            Rectangle {
                horizontal-stretch: 1;
                border-radius: Theme.radius-small;
                background: Theme.track;
                border-width: 1px;
                border-color: search-input.has-focus ? Theme.accent : Theme.separator;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 6px;
                    spacing: 6px;
                    Text {
                        text: "⌕";
                        color: Theme.text-dim;
                        font-size: 14px;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        search-input := TextInput {
                            y: (parent.height - self.height) / 2;
                            width: parent.width;
                            text <=> Lib.search;
                            color: Theme.text;
                            font-size: 12px;
                            single-line: true;
                            edited => { Lib.filters-changed(); }
                            key-pressed(e) => {
                                if (e.text == Key.Escape) {
                                    if (Lib.search != "") {
                                        Lib.search = "";
                                        Lib.filters-changed();
                                    } else {
                                        Lib.done();
                                    }
                                    return accept;
                                }
                                if (e.text == Key.Return || e.text == Key.DownArrow) {
                                    root.focus();
                                    Lib.key(e.text);
                                    return accept;
                                }
                                return reject;
                            }
                        }
                        if Lib.search == "": Text {
                            width: parent.width;
                            text: "Search (type anywhere)";
                            color: Theme.text-faint;
                            font-size: 12px;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                    }
                    if Lib.search != "": TouchArea {
                        width: 16px;
                        mouse-cursor: pointer;
                        clicked => {
                            Lib.search = "";
                            Lib.filters-changed();
                        }
                        CloseIcon {
                            size: 8px;
                        }
                    }
                    Text {
                        text: Lib.count;
                        color: Theme.text-dim;
                        font-size: Theme.font-small;
                        vertical-alignment: center;
                    }
                }
            }
            FlatButton {
                height: 28px;
                text: "Grid";
                active: !Lib.list-view;
                clicked => { Lib.list-view = false; root.focus(); }
            }
            FlatButton {
                height: 28px;
                text: "List";
                active: Lib.list-view;
                clicked => { Lib.list-view = true; root.focus(); }
            }
            if !Lib.list-view: FlatButton {
                height: 28px;
                text: Lib.tile-size == 0 ? "S" : Lib.tile-size == 1 ? "M" : "L";
                clicked => { Lib.tile-size = mod(Lib.tile-size + 1, 3); }
            }
        }

        // Views: My library, Favorites, Recent, crates, Discover, Unwanted.
        if !root.large: HorizontalLayout {
            spacing: 4px;
            height: 22px;
            for chip[i] in Lib.chips: Chip {
                text: chip.label;
                count: chip.count;
                active: chip.active;
                clicked => { Lib.chip-clicked(i); root.focus(); }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
        }

        // Filters: kind, intensity, audio-reactive.
        HorizontalLayout {
            spacing: 4px;
            height: 22px;
            if !root.is-effects: Chip {
                text: Lib.kind-names[Lib.kind];
                active: Lib.kind != 0;
                clicked => {
                    Lib.kind = mod(Lib.kind + 1, Lib.kind-names.length);
                    Lib.filters-changed();
                    root.focus();
                }
            }
            Chip {
                text: Lib.intensity == 0 ? "Any intensity" : Lib.intensity == 1 ? "Calm 0–1" : Lib.intensity == 2 ? "Medium 2–3" : "Peak 4–5";
                active: Lib.intensity != 0;
                clicked => {
                    Lib.intensity = mod(Lib.intensity + 1, 4);
                    Lib.filters-changed();
                    root.focus();
                }
            }
            if !root.is-effects: Chip {
                text: "♪ Audio-reactive";
                active: Lib.reactive;
                tint: Theme.audio;
                clicked => {
                    Lib.reactive = !Lib.reactive;
                    Lib.filters-changed();
                    root.focus();
                }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
        }

        grid := Rectangle {
            vertical-stretch: 1;
            if Lib.tiles.length == 0: Text {
                width: parent.width - 24px;
                text: Lib.empty-hint;
                color: Theme.text-faint;
                font-size: Theme.font-body;
                wrap: word-wrap;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            if !Lib.list-view: ListView {
                for row in ceil(Lib.tiles.length / root.columns): HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    padding-bottom: 6px;
                    spacing: 6px;
                    alignment: start;
                    height: root.row-h + 6px;
                    init => { Lib.rows-shown(row * root.columns, (row + 1) * root.columns); }
                    for col in root.columns: Tile {
                        property <int> idx: row * root.columns + col;
                        width: root.tile-w;
                        height: root.row-h;
                        visible: idx < Lib.tiles.length;
                        tile: idx < Lib.tiles.length ? Lib.tiles[idx] : { name: "" };
                        index: idx;
                        clicked => { Lib.tile-clicked(idx); root.focus(); }
                        double-clicked => { Lib.tile-double-clicked(idx); }
                    }
                }
            }
            if Lib.list-view: ListView {
                for tile[i] in Lib.tiles: Row {
                    tile: tile;
                    index: i;
                    odd: mod(i, 2) == 0;
                    clicked => { Lib.tile-clicked(i); root.focus(); }
                    double-clicked => { Lib.tile-double-clicked(i); }
                }
            }
        }

        // The selected item: what keys and buttons do to it.
        if Lib.selected >= 0 && !root.large: VerticalLayout {
            spacing: 4px;
            HorizontalLayout {
                height: 24px;
                spacing: 4px;
                Text {
                    horizontal-stretch: 1;
                    min-width: 60px;
                    text: Lib.selected-name;
                    color: Theme.text;
                    font-size: Theme.font-body;
                    font-weight: 600;
                    overflow: elide;
                    vertical-alignment: center;
                }
                Text {
                    text: "INTENSITY";
                    color: Theme.text-faint;
                    font-size: Theme.font-tiny;
                    vertical-alignment: center;
                }
                for n in 6: Rectangle {
                    y: 1px;
                    width: 20px;
                    height: 22px;
                    border-radius: 3px;
                    background: n == Lib.selected-intensity ? Theme.selection : n-ta.has-hover ? Theme.raised : Theme.panel;
                    border-width: 1px;
                    border-color: n == Lib.selected-intensity ? Theme.selection : Theme.border;
                    Text {
                        text: n;
                        color: n == Lib.selected-intensity ? Theme.text : Theme.text-dim;
                        font-size: Theme.font-small;
                    }
                    n-ta := TouchArea {
                        clicked => { Lib.set-intensity(n); root.focus(); }
                    }
                }
                FlatButton {
                    text: Lib.selected-favorite ? "★" : "☆";
                    active: Lib.selected-favorite;
                    tint: Theme.tempo;
                    clicked => { Lib.toggle-favorite(); root.focus(); }
                }
            }
            HorizontalLayout {
                height: 24px;
                spacing: 4px;
                if !Lib.selected-kept: FlatButton {
                    text: "Keep";
                    clicked => { Lib.set-kept(true); root.focus(); }
                }
                FlatButton {
                    text: Lib.selected-unwanted ? "Restore" : "Unwanted";
                    active: Lib.selected-unwanted;
                    tint: Theme.danger;
                    clicked => { Lib.set-unwanted(!Lib.selected-unwanted); root.focus(); }
                }
                FlatButton {
                    text: "Use Preview as thumbnail";
                    clicked => { Lib.use-preview-thumbnail(); root.focus(); }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                if !root.is-effects: FlatButton {
                    primary: true;
                    text: Lib.place-label;
                    clicked => { Lib.place(); root.focus(); }
                }
                if root.is-effects && root.clip-selected: FlatButton {
                    text: "+ Clip";
                    clicked => { Lib.effect-add(0); root.focus(); }
                }
                if root.is-effects: FlatButton {
                    text: "+ Layer";
                    clicked => { Lib.effect-add(1); root.focus(); }
                }
                if root.is-effects && root.group-selected: FlatButton {
                    text: "+ Group";
                    clicked => { Lib.effect-add(2); root.focus(); }
                }
                if root.is-effects: FlatButton {
                    text: "+ Comp";
                    clicked => { Lib.effect-add(3); root.focus(); }
                }
            }
        }
        if Lib.selected < 0 || root.large: Text {
            height: root.large ? 20px : 52px;
            text: root.is-effects
                ? "Click an effect to preview it on the selected clip, drag it onto a clip, a layer or an effect chain. 0–5 intensity · F favorite · X unwanted · Enter adds it to the layer"
                : "Click to preview, drag onto a slot or a layer to place it (or Enter for the selected slot). 0–5 intensity · F favorite · K keep · X unwanted";
            color: Theme.text-faint;
            font-size: Theme.font-small;
            wrap: word-wrap;
            vertical-alignment: center;
        }

    }
}

/// A sidebar row: a heading, or a filter with its count.
component SideRow inherits Rectangle {
    in property <LibSideRow> entry;
    callback clicked();
    height: entry.heading ? 28px : 24px;
    border-radius: Theme.radius-small;
    background: entry.active ? Theme.accent.with-alpha(0.14) : !entry.heading && ta.has-hover ? Theme.raised : transparent;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        Text {
            horizontal-stretch: 1;
            text: entry.label;
            color: entry.heading ? Theme.text-dim : entry.active ? Theme.accent : Theme.text;
            font-size: entry.heading ? Theme.font-small : 12px;
            font-weight: entry.heading ? 700 : 400;
            vertical-alignment: entry.heading ? bottom : center;
            overflow: elide;
        }
        Text {
            text: entry.count;
            color: Theme.text-dim;
            font-size: Theme.font-small;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        enabled: !entry.heading;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// A removable label (a tag or a crate) with an entry to add more.
export component LabelList inherits VerticalLayout {
    in property <string> title;
    in property <[string]> items;
    in property <string> add-hint;
    callback add(string);
    callback remove(int);
    spacing: 4px;
    vertical-stretch: 0;
    if root.title != "": Text {
        text: root.title;
        color: Theme.text-dim;
        font-size: Theme.font-small;
        font-weight: 700;
    }
    HorizontalLayout {
        spacing: 4px;
        height: 20px;
        for item[i] in root.items: Rectangle {
            height: 20px;
            width: label.preferred-width + 26px;
            border-radius: 10px;
            background: Theme.raised;
            label := Text {
                x: 8px;
                text: item;
                color: Theme.text;
                font-size: Theme.font-small;
                vertical-alignment: center;
            }
            TouchArea {
                x: parent.width - 16px;
                width: 14px;
                mouse-cursor: pointer;
                clicked => { root.remove(i); }
                CloseIcon {
                    size: 7px;
                }
            }
        }
        Rectangle {
            horizontal-stretch: 1;
            min-width: 80px;
            height: 20px;
            border-radius: 10px;
            border-width: 1px;
            border-color: entry.has-focus ? Theme.accent : Theme.border;
            entry := TextInput {
                x: 8px;
                width: parent.width - 16px;
                y: (parent.height - self.height) / 2;
                color: Theme.text;
                font-size: Theme.font-small;
                single-line: true;
                accepted => {
                    if (self.text != "") {
                        root.add(self.text);
                        self.text = "";
                    }
                }
            }
            if entry.text == "": Text {
                x: 8px;
                text: root.add-hint;
                color: Theme.text-faint;
                font-size: Theme.font-small;
                vertical-alignment: center;
            }
        }
    }
}

/// The library over the clip grid: a filter sidebar, a big grid and the selected item.
export component ExpandedLibrary inherits Rectangle {
    in property <bool> is-effects;
    in property <bool> clip-selected;
    in property <bool> group-selected;
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.separator;
    border-radius: Theme.radius;

    HorizontalLayout {
        padding: 8px;
        spacing: 10px;

        // Sidebar: library views, kinds, packs, crates, categories.
        VerticalLayout {
            width: 210px;
            spacing: 6px;
            HorizontalLayout {
                height: 26px;
                Text {
                    horizontal-stretch: 1;
                    text: "LIBRARY";
                    color: Theme.accent;
                    font-size: Theme.font-small;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                FlatButton {
                    text: "Close (Tab)";
                    clicked => { Lib.toggle-expanded(); }
                }
            }
            ListView {
                for row[i] in Lib.side-rows: SideRow {
                    entry: row;
                    clicked => { Lib.side-clicked(i); }
                }
            }
        }

        LibraryPanel {
            horizontal-stretch: 1;
            large: true;
            is-effects: root.is-effects;
            clip-selected: root.clip-selected;
            group-selected: root.group-selected;
        }

        // The selected item. The Preview monitor beside it shows it playing.
        VerticalLayout {
            width: 280px;
            spacing: 10px;
            if Lib.selected < 0: Text {
                vertical-stretch: 1;
                text: "Select an item to set its intensity, tags and crates, or put it in a slot.";
                color: Theme.text-faint;
                font-size: Theme.font-body;
                wrap: word-wrap;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
            if Lib.selected >= 0: VerticalLayout {
                spacing: 10px;
                HorizontalLayout {
                    spacing: 4px;
                    Text {
                        horizontal-stretch: 1;
                        text: Lib.selected-name;
                        color: Theme.text;
                        font-size: Theme.font-large;
                        font-weight: 600;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                    FlatButton {
                        height: 28px;
                        text: Lib.selected-favorite ? "★" : "☆";
                        active: Lib.selected-favorite;
                        tint: Theme.tempo;
                        clicked => { Lib.toggle-favorite(); }
                    }
                }
                Text {
                    text: Lib.selected-detail;
                    color: Theme.text-dim;
                    font-size: Theme.font-body;
                    wrap: word-wrap;
                }
                Text {
                    text: "INTENSITY";
                    color: Theme.text-dim;
                    font-size: Theme.font-small;
                    font-weight: 700;
                }
                HorizontalLayout {
                    spacing: 4px;
                    height: 28px;
                    for n in 6: Rectangle {
                        border-radius: Theme.radius-small;
                        background: n == Lib.selected-intensity ? Theme.selection : big-ta.has-hover ? Theme.raised : Theme.panel-2;
                        border-width: 1px;
                        border-color: n == Lib.selected-intensity ? Theme.selection : Theme.border;
                        Text {
                            text: n;
                            color: n == Lib.selected-intensity ? Theme.text : Theme.text-dim;
                            font-size: 12px;
                        }
                        big-ta := TouchArea {
                            clicked => { Lib.set-intensity(n); }
                        }
                    }
                }
                Text {
                    text: "0 calm … 5 peak";
                    color: Theme.text-faint;
                    font-size: Theme.font-small;
                }
                LabelList {
                    title: "TAGS";
                    items: Lib.selected-tags;
                    add-hint: "+ tag";
                    add(t) => { Lib.add-tag(t); }
                    remove(i) => { Lib.remove-tag(i); }
                }
                LabelList {
                    title: "CRATES";
                    items: Lib.selected-crates;
                    add-hint: "+ crate";
                    add(t) => { Lib.add-to-crate(t); }
                    remove(i) => { Lib.remove-from-crate(i); }
                }
                Text {
                    text: Lib.selected-usage;
                    color: Theme.text-faint;
                    font-size: Theme.font-small;
                }
                Rectangle {
                    vertical-stretch: 1;
                }
                HorizontalLayout {
                    spacing: 4px;
                    if !Lib.selected-kept: FlatButton {
                        text: "Keep";
                        clicked => { Lib.set-kept(true); }
                    }
                    FlatButton {
                        text: Lib.selected-unwanted ? "Restore" : "Unwanted";
                        active: Lib.selected-unwanted;
                        tint: Theme.danger;
                        clicked => { Lib.set-unwanted(!Lib.selected-unwanted); }
                    }
                    FlatButton {
                        text: "Use Preview as thumbnail";
                        clicked => { Lib.use-preview-thumbnail(); }
                    }
                }
                if !Lib.selected-is-effect: FlatButton {
                    height: 30px;
                    text: "Add to playlist";
                    clicked => { Lib.add-to-playlist(); }
                }
                if !Lib.selected-is-effect: FlatButton {
                    height: 34px;
                    primary: true;
                    text: Lib.place-label;
                    clicked => { Lib.place(); }
                }
                if Lib.selected-is-effect: HorizontalLayout {
                    spacing: 4px;
                    if root.clip-selected: FlatButton {
                        height: 30px;
                        text: "+ Clip";
                        clicked => { Lib.effect-add(0); }
                    }
                    FlatButton {
                        height: 30px;
                        text: "+ Layer";
                        clicked => { Lib.effect-add(1); }
                    }
                    if root.group-selected: FlatButton {
                        height: 30px;
                        text: "+ Group";
                        clicked => { Lib.effect-add(2); }
                    }
                    FlatButton {
                        height: 30px;
                        text: "+ Comp";
                        clicked => { Lib.effect-add(3); }
                    }
                }
            }
        }
    }
}
