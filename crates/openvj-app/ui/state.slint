// Data shared between the Rust app and the UI.

/// Parameter scopes; must match `Scope` in app.rs.
export global Scope {
    out property <int> comp: 0;
    out property <int> comp-fx: 1;
    out property <int> layer: 2;
    out property <int> layer-fx: 3;
    out property <int> clip: 4;
    out property <int> group: 5;
    out property <int> group-fx: 6;
    out property <int> clip-fx: 7;
    out property <int> layer-tf: 8;
    out property <int> clip-tf: 9;
}

/// Names for modulation menus, filled in from Rust.
export global ModNames {
    // ModSource::ALL names.
    in property <[string]> sources;
    // Index of the first tempo shape in `sources` (ModSource::FIRST_TEMPO); audio sources come before it.
    in property <int> first-tempo: 11;
    // MOD_RATES labels.
    in property <[string]> rates;
    // Codes sent through `mod-tempo` besides a rate index (must match `TEMPO_*` in app.rs):
    // phase-code + 0..3 sets the phase in quarters; restart-code + 0/1 sets restart on launch.
    out property <int> phase-code: 100;
    out property <int> restart-code: 200;
}

/// Live audio levels, updated every frame.
export global AudioLevels {
    in property <[float]> bands: [0, 0, 0, 0];
    in property <[string]> band-names: ["Bass", "Low mid", "High mid", "Treble"];
    in property <float> level;
}

/// One parameter row. `value` is the base the user sets, `live` is the value after
/// modulation this frame. Both are normalised 0..1.
export struct ParamData {
    index: int,
    name: string,
    value: float,
    live: float,
    reset: float,
    display: string,
    modulatable: bool,
    mod-source: int,
    mod-amount: float,
    mod-rate: int,
    // Phase in quarters of a cycle (0..3), and restart on launch, for tempo shapes.
    mod-phase: int,
    mod-restart: bool,
    // Restart on launch makes sense here (clip parameters and clip effects).
    restartable: bool,
}

export struct EffectData {
    name: string,
    enabled: bool,
    /// Where the effect came from, such as its Shadertoy page; empty for most.
    source: string,
    params: [ParamData],
}

export struct CellData {
    name: string,
    kind: string,
    thumb: image,
    has-thumb: bool,
    filled: bool,
    playing: bool,
    selected: bool,
    loading: bool,
    error: bool,
    modulated: bool,
}

export struct LayerData {
    index: int,
    name: string,
    opacity: float,
    live-opacity: float,
    blend: int,
    bypass: bool,
    solo: bool,
    selected: bool,
    live: bool,
    fx-count: int,
    // Crossfader side: "A", "B" or "".
    side: string,
    // Name of the layer's group, or "".
    group: string,
    cells: [CellData],
}

export struct ColumnData {
    name: string,
    active: bool,
}

export struct DeckData {
    name: string,
    active: bool,
}

export struct BrowserItem {
    name: string,
    detail: string,
    kind: string,
    armed: bool,
}

// One item in the library grid (ui/library.slint).
export struct LibTile {
    name: string,
    detail: string,
    // GEN, FX, MD or PRE.
    kind: string,
    thumb: image,
    has-thumb: bool,
    // 0 to 5, or -1 when unset.
    intensity: int,
    favorite: bool,
    reactive: bool,
    selected: bool,
    armed: bool,
    unwanted: bool,
}

// A view chip above the library grid: My library, Favorites, a crate…
export struct LibChip {
    label: string,
    count: string,
    active: bool,
}

// A row of the expanded library's sidebar: a heading or a filter with its count.
export struct LibSideRow {
    label: string,
    count: string,
    active: bool,
    heading: bool,
}
