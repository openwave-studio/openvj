// The Synthesis layout: one visual at a time, laid out like a hardware synth, to perform
// with. Knobs are used here only (the maintainer, 2026-11-15); the rest of the app keeps
// Resolume-style bars.
import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Scope, ParamData, EffectData } from "state.slint";
import { ModButton, FlatButton, BlendPicker } from "controls.slint";
import { Switch } from "settings.slint";

/// One tile in the media browser.
export struct MediaTile {
    name: string,
    // ClipSource kind label: image, video, camera, syphon.
    kind: string,
    thumb: image,
    has-thumb: bool,
    // It's the focused layer's overlay now.
    current: bool,
}

/// Overlay transport buttons, as the app numbers them.
global Transport {
    out property <int> play: 0;
    out property <int> prev: 1;
    out property <int> next: 2;
    out property <int> stop: 3;
}

/// A square transport button with a drawn icon.
component TransportButton inherits Rectangle {
    in property <string> icon;
    in property <bool> active;
    in property <bool> round;
    callback clicked();
    width: root.round ? 40px : 32px;
    height: self.width;
    border-radius: root.round ? self.width / 2 : Theme.radius;
    background: root.active ? Theme.accent-dim : ta.pressed ? Theme.pressed : ta.has-hover ? Theme.raised : Theme.panel-2;
    border-width: 1px;
    border-color: root.active ? Theme.accent : Theme.border;
    Path {
        width: 14px;
        height: 14px;
        viewbox-width: 14;
        viewbox-height: 14;
        fill: root.active ? Theme.accent : Theme.text;
        stroke: transparent;
        commands: root.icon;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// One layer in the Synthesis strip.
export struct SynthLayer {
    index: int,
    name: string,
    // Name of the clip it plays, or "".
    clip: string,
    thumb: image,
    has-thumb: bool,
    focused: bool,
}

/// A knob for a 0..1 parameter: drag up or down, double-click to reset. The arc shows the
/// value; a dot shows the live value when a driver or macro moves it. In map mode a click
/// puts the parameter on (or takes it off) the macro being mapped.
export component Knob inherits Rectangle {
    in property <ParamData> data;
    in property <length> size: 46px;
    in property <color> tint: Theme.accent;
    // Shown instead of the parameter's own name, when set.
    in property <string> label;
    // A macro is being mapped: clicks map instead of turning.
    in property <bool> map-mode;
    // The macro being mapped, to light the knobs it already moves.
    in property <int> map-macro: -1;
    callback set(int, float);
    callback toggled(int);
    // A drag starts: the section remembers its values for undo.
    callback grabbed();

    property <float> v: clamp(root.data.value, 0, 1);
    property <float> lv: clamp(root.data.live, 0, 1);
    property <float> r: 20;
    property <angle> a0: -135deg;
    property <angle> a1: root.a0 + 270deg * root.v;
    property <angle> al: root.a0 + 270deg * root.lv;
    property <bool> on-map: root.map-mode && root.data.macro-index == root.map-macro;
    property <float> start-value;

    width: root.size + 22px;
    height: root.size + 38px;

    Rectangle {
        x: 2px;
        y: 0;
        width: parent.width - 4px;
        height: root.size + 4px;
        border-radius: Theme.radius;
        background: root.on-map ? root.tint.with-alpha(0.22) : root.map-mode && ta.has-hover ? Theme.raised : transparent;
        border-width: root.map-mode ? 1px : 0;
        border-color: root.on-map ? root.tint : Theme.border;
    }

    Path {
        x: (parent.width - root.size) / 2;
        y: 2px;
        width: root.size;
        height: root.size;
        viewbox-width: 48;
        viewbox-height: 48;
        stroke: Theme.chosen;
        stroke-width: 3px;
        fill: transparent;
        commands: "M " + (24 + root.r * sin(root.a0)) + " " + (24 - root.r * cos(root.a0))
            + " A " + root.r + " " + root.r + " 0 1 1 " + (24 + root.r * sin(root.a0 + 270deg)) + " " + (24 - root.r * cos(root.a0 + 270deg));
    }
    if root.v > 0.002: Path {
        x: (parent.width - root.size) / 2;
        y: 2px;
        width: root.size;
        height: root.size;
        viewbox-width: 48;
        viewbox-height: 48;
        stroke: root.data.macro-index >= 0 ? root.tint.darker(0.25) : root.tint;
        stroke-width: 3px;
        fill: transparent;
        commands: "M " + (24 + root.r * sin(root.a0)) + " " + (24 - root.r * cos(root.a0))
            + " A " + root.r + " " + root.r + " 0 " + (root.v > 0.6667 ? 1 : 0) + " 1 " + (24 + root.r * sin(root.a1)) + " " + (24 - root.r * cos(root.a1));
    }
    // Pointer.
    Path {
        x: (parent.width - root.size) / 2;
        y: 2px;
        width: root.size;
        height: root.size;
        viewbox-width: 48;
        viewbox-height: 48;
        stroke: Theme.text;
        stroke-width: 2px;
        fill: transparent;
        commands: "M " + (24 + 7 * sin(root.a1)) + " " + (24 - 7 * cos(root.a1)) + " L " + (24 + 15 * sin(root.a1)) + " " + (24 - 15 * cos(root.a1));
    }
    // Live value, when something moves it.
    if abs(root.lv - root.v) > 0.004: Rectangle {
        x: (parent.width - root.size) / 2 + (24 + root.r * sin(root.al)) / 48 * root.size - 3px;
        y: 2px + (24 - root.r * cos(root.al)) / 48 * root.size - 3px;
        width: 6px;
        height: 6px;
        border-radius: 3px;
        background: root.data.mod-source != 0 ? Theme.mod-color(root.data.mod-source) : Theme.text;
    }
    if root.data.macro-index >= 0: Text {
        x: parent.width - self.width - 2px;
        y: 0;
        text: "M" + (root.data.macro-index + 1);
        color: root.tint;
        font-size: Theme.font-tiny;
        font-weight: 700;
    }

    Text {
        y: root.size + 6px;
        width: parent.width;
        text: root.label != "" ? root.label : root.data.name;
        color: root.data.mod-source != 0 ? Theme.mod-color(root.data.mod-source) : Theme.text-dim;
        font-size: Theme.font-small;
        horizontal-alignment: center;
        overflow: elide;
    }
    Text {
        y: root.size + 20px;
        width: parent.width;
        text: root.data.display;
        color: Theme.text;
        font-size: Theme.font-small;
        font-weight: 600;
        horizontal-alignment: center;
        overflow: elide;
    }

    ta := TouchArea {
        mouse-cursor: root.map-mode ? pointer : ns-resize;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.start-value = root.data.value;
                if (!root.map-mode) {
                    root.grabbed();
                }
            }
        }
        moved => {
            if (!root.map-mode && self.pressed) {
                root.set(root.data.index, clamp(root.start-value + (self.pressed-y - self.mouse-y) / 160px, 0, 1));
            }
        }
        clicked => {
            if (root.map-mode) {
                root.toggled(root.data.index);
            }
        }
        double-clicked => {
            if (!root.map-mode) {
                root.grabbed();
                root.set(root.data.index, root.data.reset);
            }
        }
    }
}

/// One of the group tools: lock, undo, default (back to defaults) or random.
export global GroupOp {
    out property <int> lock: 0;
    out property <int> undo: 1;
    out property <int> default: 2;
    out property <int> random: 3;
}

component ToolIcon inherits Path {
    in property <int> op;
    in property <color> tint;
    width: 11px;
    height: 11px;
    viewbox-width: 12;
    viewbox-height: 12;
    stroke: root.tint;
    stroke-width: 1.3px;
    fill: transparent;
    commands: root.op == GroupOp.lock ? "M 1.5 5.5 L 10.5 5.5 L 10.5 11 L 1.5 11 Z M 3.5 5.5 L 3.5 3.5 Q 3.5 1 6 1 Q 8.5 1 8.5 3.5 L 8.5 5.5"
        : root.op == GroupOp.undo ? "M 3.5 1.5 L 1 4.5 L 4 7 M 1.3 4.5 L 7 4.5 Q 11 4.5 11 7.8 Q 11 11 7 11 L 4 11"
        : root.op == GroupOp.default ? "M 11 6 L 1.5 6 M 5 2.5 L 1.5 6 L 5 9.5"
        : "M 1 3 L 3.5 3 L 8 9 L 11 9 M 1 9 L 3.5 9 L 8 3 L 11 3 M 9.5 1.5 L 11 3 L 9.5 4.5 M 9.5 7.5 L 11 9 L 9.5 10.5";
}

/// A small square tool button, for a section's column of tools.
component ToolButton inherits Rectangle {
    in property <int> op;
    in property <bool> active;
    in property <bool> enabled: true;
    callback clicked();
    width: 20px;
    height: 18px;
    border-radius: Theme.radius-small;
    background: root.active ? Theme.accent-dim : ta.has-hover && root.enabled ? Theme.raised : transparent;
    border-width: root.active ? 1px : 0;
    border-color: Theme.accent;
    opacity: root.enabled ? 1 : 0.4;
    ToolIcon {
        op: root.op;
        tint: root.active ? Theme.accent : ta.has-hover ? Theme.text : Theme.text-dim;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// A labelled tool button, for a whole row of sections.
component RowToolButton inherits Rectangle {
    in property <int> op;
    in property <string> text;
    in property <bool> active;
    in property <bool> enabled: true;
    callback clicked();
    width: label.preferred-width + 30px;
    height: 22px;
    border-radius: Theme.radius;
    background: root.active ? Theme.accent-dim : ta.has-hover && root.enabled ? Theme.raised : Theme.panel-2;
    border-width: 1px;
    border-color: root.active ? Theme.accent : Theme.border;
    opacity: root.enabled ? 1 : 0.5;
    ToolIcon {
        x: 8px;
        op: root.op;
        tint: root.active ? Theme.accent : Theme.text-dim;
    }
    label := Text {
        x: 24px;
        text: root.text;
        color: root.active ? Theme.accent : Theme.text;
        font-size: Theme.font-small;
        font-weight: 600;
        vertical-alignment: center;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// A row's title with lock, undo, default and random for every section in it.
component RowHeader inherits Rectangle {
    in property <string> title;
    in property <bool> locked;
    in property <bool> enabled: true;
    in property <bool> tools: true;
    callback tool(int);
    height: 26px;
    Text {
        x: 2px;
        text: root.title;
        color: Theme.text-dim;
        font-size: Theme.font-small;
        font-weight: 700;
        letter-spacing: 0.6px;
        vertical-alignment: center;
    }
    if root.tools: HorizontalLayout {
        x: parent.width - self.preferred-width;
        width: self.preferred-width;
        spacing: 4px;
        alignment: end;
        RowToolButton { op: GroupOp.lock; text: root.locked ? "unlock" : "lock"; active: root.locked; enabled: root.enabled; clicked => { root.tool(GroupOp.lock); } }
        RowToolButton { op: GroupOp.undo; text: "undo"; enabled: root.enabled; clicked => { root.tool(GroupOp.undo); } }
        RowToolButton { op: GroupOp.default; text: "default"; enabled: root.enabled && !root.locked; clicked => { root.tool(GroupOp.default); } }
        RowToolButton { op: GroupOp.random; text: "random"; enabled: root.enabled && !root.locked; clicked => { root.tool(GroupOp.random); } }
    }
}

/// A titled panel of knobs, laid out in rows of `columns`.
component KnobSection inherits Rectangle {
    in property <string> title;
    in property <color> title-color: Theme.text-dim;
    in property <[ParamData]> params;
    in property <int> columns: 4;
    in property <bool> map-mode;
    in property <int> map-macro;
    in property <bool> dimmed;
    in property <bool> locked;
    callback set(int, float);
    callback toggled(int);
    callback grabbed();
    callback tool(int);

    property <length> kw: 68px;
    property <length> kh: 86px;
    property <length> tools-w: 26px;
    property <int> cols: min(root.columns, max(1, root.params.length));

    width: root.cols * root.kw + 20px + root.tools-w;
    height: max(34px + ceil(root.params.length / root.cols) * root.kh + 8px, 26px + 4 * 21px + 8px);
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.separator;
    border-radius: Theme.radius;
    opacity: root.dimmed ? 0.5 : 1;

    Text {
        x: 10px;
        y: 8px;
        width: parent.width - 20px - root.tools-w;
        text: root.title;
        color: root.title-color;
        font-size: Theme.font-small;
        font-weight: 600;
        letter-spacing: 0.6px;
        overflow: elide;
    }
    for p[i] in root.params: Knob {
        x: 10px + mod(i, root.cols) * root.kw + (root.kw - self.width) / 2;
        y: 30px + floor(i / root.cols) * root.kh;
        data: p;
        map-mode: root.map-mode;
        map-macro: root.map-macro;
        set(k, v) => { root.set(k, v); }
        toggled(k) => { root.toggled(k); }
        grabbed => { root.grabbed(); }
    }
    // Lock, undo, default and random for this section, down the right edge.
    VerticalLayout {
        x: parent.width - root.tools-w - 2px;
        y: 26px;
        width: 22px;
        spacing: 3px;
        alignment: start;
        ToolButton { op: GroupOp.lock; active: root.locked; clicked => { root.tool(GroupOp.lock); } }
        ToolButton { op: GroupOp.undo; clicked => { root.tool(GroupOp.undo); } }
        ToolButton { op: GroupOp.default; enabled: !root.locked; clicked => { root.tool(GroupOp.default); } }
        ToolButton { op: GroupOp.random; enabled: !root.locked; clicked => { root.tool(GroupOp.random); } }
    }
}

/// An on/off parameter as a switch with its name under it, in a knob-sized cell.
component SwitchCell inherits Rectangle {
    in property <ParamData> data;
    callback set(int, float);
    callback grabbed();
    width: 68px;
    height: 86px;
    Switch {
        x: (parent.width - self.width) / 2;
        y: 14px;
        on: root.data.value >= 0.5;
        toggled(on) => {
            root.grabbed();
            root.set(root.data.index, on ? 1 : 0);
        }
    }
    Text {
        y: 52px;
        width: parent.width;
        text: root.data.name;
        color: Theme.text-dim;
        font-size: Theme.font-small;
        horizontal-alignment: center;
        overflow: elide;
    }
}

struct Rgb { r: float, g: float, b: float }

/// A colour parameter (three channels from `first`): a swatch that opens a palette.
component ColorCell inherits Rectangle {
    in property <[ParamData]> params;
    in property <int> first;
    in property <string> label;
    callback set(int, float);
    callback grabbed();
    property <float> r: root.params.length > root.first + 2 ? root.params[root.first].value : 0;
    property <float> g: root.params.length > root.first + 2 ? root.params[root.first + 1].value : 0;
    property <float> b: root.params.length > root.first + 2 ? root.params[root.first + 2].value : 0;
    // Hues across, then lighter and darker rows, then greys.
    property <[Rgb]> palette: [
        { r: 1, g: 0.23, b: 0.19 }, { r: 1, g: 0.55, b: 0 }, { r: 1, g: 0.84, b: 0.04 }, { r: 0.2, g: 0.84, b: 0.35 },
        { r: 0.31, g: 0.9, b: 0.85 }, { r: 0.04, g: 0.52, b: 1 }, { r: 0.37, g: 0.36, b: 0.9 }, { r: 0.75, g: 0.35, b: 0.95 },
        { r: 1, g: 0.6, b: 0.6 }, { r: 1, g: 0.8, b: 0.55 }, { r: 1, g: 0.95, b: 0.6 }, { r: 0.65, g: 0.95, b: 0.7 },
        { r: 0.7, g: 1, b: 0.97 }, { r: 0.6, g: 0.8, b: 1 }, { r: 0.75, g: 0.74, b: 1 }, { r: 0.95, g: 0.7, b: 1 },
        { r: 0.4, g: 0.04, b: 0.05 }, { r: 0.45, g: 0.2, b: 0 }, { r: 0.4, g: 0.33, b: 0 }, { r: 0, g: 0.3, b: 0.1 },
        { r: 0, g: 0.3, b: 0.3 }, { r: 0, g: 0.15, b: 0.4 }, { r: 0.12, g: 0.1, b: 0.35 }, { r: 0.3, g: 0.05, b: 0.35 },
        { r: 0, g: 0, b: 0 }, { r: 0.2, g: 0.2, b: 0.2 }, { r: 0.4, g: 0.4, b: 0.4 }, { r: 0.6, g: 0.6, b: 0.6 },
        { r: 0.8, g: 0.8, b: 0.8 }, { r: 1, g: 1, b: 1 },
    ];
    width: 68px;
    height: 86px;
    swatch := Rectangle {
        x: (parent.width - 30px) / 2;
        y: 10px;
        width: 30px;
        height: 30px;
        border-radius: 15px;
        background: rgb(root.r * 255, root.g * 255, root.b * 255);
        border-width: ta.has-hover ? 2px : 1px;
        border-color: ta.has-hover ? Theme.accent : Theme.border;
        ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { popup.show(); }
        }
    }
    Text {
        y: 52px;
        width: parent.width;
        text: root.label;
        color: Theme.text-dim;
        font-size: Theme.font-small;
        horizontal-alignment: center;
        overflow: elide;
    }
    popup := PopupWindow {
        x: 0;
        y: 44px;
        width: 8 * 22px + 12px;
        height: 4 * 22px + 12px;
        Rectangle {
            background: Theme.raised;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 8px;
            drop-shadow-color: #00000080;
        }
        for c[i] in root.palette: Rectangle {
            x: 6px + mod(i, 8) * 22px;
            y: 6px + floor(i / 8) * 22px;
            width: 18px;
            height: 18px;
            border-radius: 9px;
            background: rgb(c.r * 255, c.g * 255, c.b * 255);
            border-width: pta.has-hover ? 2px : 0;
            border-color: Theme.text;
            pta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.grabbed();
                    root.set(root.first, c.r);
                    root.set(root.first + 1, c.g);
                    root.set(root.first + 2, c.b);
                }
            }
        }
    }
}

/// A titled panel holding any controls, with the group tools down its right edge.
component ToolPanel inherits Rectangle {
    in property <string> title;
    in property <color> title-color: Theme.text-dim;
    in property <bool> locked;
    in property <bool> dimmed;
    callback tool(int);
    property <length> tools-w: 26px;
    height: 34px + 86px + 8px;
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.separator;
    border-radius: Theme.radius;
    opacity: root.dimmed ? 0.5 : 1;
    Text {
        x: 10px;
        y: 8px;
        width: parent.width - 20px - root.tools-w;
        text: root.title;
        color: root.title-color;
        font-size: Theme.font-small;
        font-weight: 600;
        letter-spacing: 0.6px;
        overflow: elide;
    }
    Rectangle {
        x: 10px;
        y: 30px;
        width: parent.width - 20px - root.tools-w;
        height: 86px;
        @children
    }
    VerticalLayout {
        x: parent.width - root.tools-w - 2px;
        y: 26px;
        width: 22px;
        spacing: 3px;
        alignment: start;
        ToolButton { op: GroupOp.lock; active: root.locked; clicked => { root.tool(GroupOp.lock); } }
        ToolButton { op: GroupOp.undo; clicked => { root.tool(GroupOp.undo); } }
        ToolButton { op: GroupOp.default; enabled: !root.locked; clicked => { root.tool(GroupOp.default); } }
        ToolButton { op: GroupOp.random; enabled: !root.locked; clicked => { root.tool(GroupOp.random); } }
    }
}

export component SynthesisLayout inherits Rectangle {
    in property <image> output-image;
    in property <image> preview-image;
    in property <[SynthLayer]> layers;
    in property <string> clip-title;
    in property <bool> has-clip;
    in property <[ParamData]> macros;
    // How many parameters each macro moves.
    in property <[int]> macro-counts;
    in property <[ParamData]> clip-params;
    in property <[EffectData]> clip-effects;
    in property <[ParamData]> layer-params;
    in property <[ParamData]> comp-params;
    // Group tools: which sections are locked.
    in property <bool> source-locked;
    in property <[bool]> fx-locked;
    in property <bool> scene-locked;
    // META: the focused layer's look channels (effects/layer_look.fs order), and locks for
    // its sections: master, color, mirror, limit colors, general.
    in property <[ParamData]> look;
    in property <[bool]> meta-locked;
    in property <bool> meta-row-locked;
    // MEDIA: the focused layer's overlay (params: amount, speed, scale, fill, flip v, flip h;
    // look: META channels, of which colour shows invert, gamma, contrast, hue, saturation),
    // locks for its transform and colour sections, and the media browser.
    in property <[bool]> media-locked;
    in property <bool> overlay-valid;
    in property <string> overlay-name;
    in property <image> overlay-thumb;
    in property <bool> overlay-has-thumb;
    in property <bool> overlay-playing;
    in property <float> overlay-progress;
    in property <bool> overlay-has-length;
    in property <int> overlay-blend;
    in property <int> overlay-play-mode;
    in property <[ParamData]> overlay-params;
    in property <[ParamData]> overlay-look;
    in property <[string]> blend-modes;
    in property <[string]> play-modes;
    in property <[string]> media-chips;
    in property <int> media-chip;
    in property <bool> media-browser-locked;
    in property <[MediaTile]> media-items;
    callback overlay-pick(int);
    callback overlay-clear();
    callback overlay-transport(int);
    callback overlay-scrub(float);
    callback overlay-play-mode-picked(int);
    callback overlay-blend-picked(int);
    callback media-chip-picked(int);
    callback media-lock();
    callback media-refresh();
    callback media-add-folder();
    callback media-remove-folder(int);
    callback focus-layer(int);
    callback group-tool(int, int, int);
    callback row-tool(int, int);
    callback group-touch(int, int);
    callback param-set(int, int, int, float);
    callback param-mod(int, int, int, int);
    callback macro-toggle(int, int, int, int);
    callback macro-clear(int);
    callback add-to-playlist();

    // The macro being mapped, or -1.
    in-out property <int> map-macro: -1;

    background: Theme.bg;

    HorizontalLayout {
        padding: 8px;
        spacing: 8px;

        // Layers, top first, each with what it plays.
        Rectangle {
            width: 180px;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.separator;
            border-radius: Theme.radius;
            VerticalLayout {
                padding: 8px;
                spacing: 4px;
                alignment: start;
                Text {
                    height: 20px;
                    text: "LAYERS";
                    color: Theme.text-dim;
                    font-size: Theme.font-small;
                    font-weight: 600;
                    letter-spacing: 0.6px;
                }
                for l in root.layers: Rectangle {
                    height: 52px;
                    border-radius: Theme.radius;
                    background: l.focused ? Theme.accent.with-alpha(0.14) : lta.has-hover ? Theme.raised : transparent;
                    border-width: l.focused ? 1px : 0;
                    border-color: Theme.accent;
                    HorizontalLayout {
                        padding: 6px;
                        spacing: 8px;
                        Rectangle {
                            width: 64px;
                            background: Theme.track;
                            if l.has-thumb: Image {
                                width: parent.width;
                                height: parent.height;
                                source: l.thumb;
                                image-fit: cover;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: l.name;
                                color: l.focused ? Theme.accent : Theme.text;
                                font-size: Theme.font-body;
                                font-weight: 600;
                                overflow: elide;
                            }
                            Text {
                                text: l.clip == "" ? "nothing playing" : l.clip;
                                color: Theme.text-faint;
                                font-size: Theme.font-small;
                                overflow: elide;
                            }
                        }
                    }
                    lta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.focus-layer(l.index); }
                    }
                }
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 8px;

            // The visual, large, and the output beside it.
            HorizontalLayout {
                height: 250px;
                spacing: 8px;
                Rectangle {
                    horizontal-stretch: 1;
                    background: Theme.track;
                    border-radius: Theme.radius;
                    Image {
                        width: parent.width;
                        height: parent.height;
                        source: root.preview-image;
                        image-fit: contain;
                    }
                    Rectangle {
                        x: 8px;
                        y: 8px;
                        width: title.preferred-width + 16px;
                        height: 24px;
                        border-radius: Theme.radius;
                        background: #000000a0;
                        title := Text {
                            text: root.has-clip ? root.clip-title : "Pick a layer that plays something";
                            color: Theme.text;
                            font-size: Theme.font-normal;
                            font-weight: 600;
                        }
                    }
                }
                VerticalLayout {
                    width: 300px;
                    spacing: 6px;
                    alignment: start;
                    Text {
                        text: "OUTPUT";
                        color: Theme.accent;
                        font-size: Theme.font-small;
                        font-weight: 600;
                        letter-spacing: 0.6px;
                    }
                    Rectangle {
                        height: self.width * 9 / 16;
                        background: Theme.track;
                        Image {
                            width: parent.width;
                            height: parent.height;
                            source: root.output-image;
                            image-fit: contain;
                        }
                    }
                    FlatButton {
                        text: "Add to playlist";
                        enabled: root.has-clip;
                        clicked => { root.add-to-playlist(); }
                    }
                }
            }

            // Everything below the preview scrolls.
            below := ScrollView {
                vertical-stretch: 1;
                content-width: self.visible-width;
                content-height: col.preferred-height;
                col := VerticalLayout {
                    width: below.visible-width;
                    spacing: 8px;
                    // Macros.
                    Rectangle {
                        height: 150px;
                        background: Theme.panel;
                        border-width: 1px;
                        border-color: root.map-macro >= 0 ? Theme.accent : Theme.separator;
                        border-radius: Theme.radius;
                        opacity: root.has-clip ? 1 : 0.5;
                        Text {
                            x: 10px;
                            y: 8px;
                            text: root.map-macro >= 0
                                ? "MAPPING MACRO " + (root.map-macro + 1) + ": click knobs below to add or remove them, then Done"
                                : "MACROS";
                            color: root.map-macro >= 0 ? Theme.accent : Theme.text-dim;
                            font-size: Theme.font-small;
                            font-weight: 600;
                            letter-spacing: 0.6px;
                        }
                        HorizontalLayout {
                            y: 26px;
                            height: parent.height - 30px;
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 4px;
                            alignment: start;
                            for m[i] in root.macros: VerticalLayout {
                                spacing: 2px;
                                Knob {
                                    size: 52px;
                                    data: m;
                                    set(k, v) => { root.param-set(Scope.clip-macro, 0, k, v); }
                                }
                                HorizontalLayout {
                                    spacing: 2px;
                                    alignment: center;
                                    ModButton {
                                        width: 44px;
                                        source: m.mod-source;
                                        rate: m.mod-rate;
                                        picked(s) => { root.param-mod(Scope.clip-macro, 0, i, s); }
                                    }
                                    Rectangle {
                                        width: 28px;
                                        height: 20px;
                                        border-radius: Theme.radius-small;
                                        background: root.map-macro == i ? Theme.accent : map-ta.has-hover ? Theme.raised : Theme.panel-2;
                                        border-width: 1px;
                                        border-color: root.map-macro == i ? Theme.accent : Theme.border;
                                        Text {
                                            text: root.map-macro == i ? "Done" : "Map";
                                            color: root.map-macro == i ? Theme.on-accent : root.macro-counts[i] > 0 ? Theme.accent : Theme.text-dim;
                                            font-size: Theme.font-tiny;
                                            font-weight: 700;
                                        }
                                        map-ta := TouchArea {
                                            enabled: root.has-clip;
                                            mouse-cursor: pointer;
                                            clicked => { root.map-macro = root.map-macro == i ? -1 : i; }
                                        }
                                    }
                                }
                                Text {
                                    text: root.macro-counts[i] == 0 ? "empty" : root.macro-counts[i] == 1 ? "1 param" : root.macro-counts[i] + " params";
                                    color: Theme.text-faint;
                                    font-size: Theme.font-tiny;
                                    horizontal-alignment: center;
                                }
                            }
                        }
                    }

                    // SCENE CONTROLS: the visual's own sections, the source and each effect.
                    RowHeader {
                        title: "SCENE CONTROLS";
                        locked: root.scene-locked;
                        enabled: root.has-clip && root.map-macro < 0;
                        tool(op) => { root.row-tool(0, op); }
                    }
                    ScrollView {
                        height: 34px + 86px + 8px + 12px;
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            if root.clip-params.length > 0: KnobSection {
                                y: 0;
                                title: "SOURCE";
                                title-color: Theme.gen;
                                params: root.clip-params;
                                columns: 6;
                                map-mode: root.map-macro >= 0;
                                map-macro: root.map-macro;
                                locked: root.source-locked;
                                set(k, v) => { root.param-set(Scope.clip, 0, k, v); }
                                toggled(k) => { root.macro-toggle(root.map-macro, Scope.clip, 0, k); }
                                grabbed => { root.group-touch(Scope.clip, 0); }
                                tool(op) => { root.group-tool(Scope.clip, 0, op); }
                            }
                            for fx[e] in root.clip-effects: KnobSection {
                                y: 0;
                                title: "FX · " + fx.name;
                                params: fx.params;
                                columns: 4;
                                dimmed: !fx.enabled;
                                map-mode: root.map-macro >= 0;
                                map-macro: root.map-macro;
                                locked: root.fx-locked[e];
                                set(k, v) => { root.param-set(Scope.clip-fx, e, k, v); }
                                toggled(k) => { root.macro-toggle(root.map-macro, Scope.clip-fx, e, k); }
                                grabbed => { root.group-touch(Scope.clip-fx, e); }
                                tool(op) => { root.group-tool(Scope.clip-fx, e, op); }
                            }
                            Rectangle {
                                width: 68px + 20px;
                                height: 34px + 86px + 8px;
                                background: Theme.panel;
                                border-width: 1px;
                                border-color: Theme.separator;
                                border-radius: Theme.radius;
                                opacity: root.map-macro >= 0 ? 0.5 : 1;
                                Text {
                                    x: 10px;
                                    y: 8px;
                                    text: "OUTPUT";
                                    color: Theme.accent;
                                    font-size: Theme.font-small;
                                    font-weight: 600;
                                    letter-spacing: 0.6px;
                                }
                                if root.comp-params.length > 0: Knob {
                                    x: 10px + (68px - self.width) / 2;
                                    y: 30px;
                                    data: root.comp-params[0];
                                    set(k, v) => { root.param-set(Scope.comp, 0, k, v); }
                                }
                            }
                        }
                    }
                    // META CONTROLS: the layer's look, the same for every visual it plays.
                    RowHeader {
                        title: "META CONTROLS";
                        locked: root.meta-row-locked;
                        enabled: root.layers.length > 0 && root.map-macro < 0;
                        tool(op) => { root.row-tool(1, op); }
                    }
                    ScrollView {
                        height: 34px + 86px + 8px + 12px;
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            opacity: root.map-macro >= 0 ? 0.5 : 1;
                            ToolPanel {
                                width: 68px + 20px + 26px;
                                title: "MASTER";
                                title-color: Theme.accent;
                                locked: root.meta-locked[0];
                                tool(op) => { root.group-tool(Scope.layer-look, 0, op); }
                                if root.layer-params.length > 0: Knob {
                                    x: (68px - self.width) / 2;
                                    data: root.layer-params[0];
                                    label: "Master";
                                    set(k, v) => { root.param-set(Scope.layer, -1, k, v); }
                                    grabbed => { root.group-touch(Scope.layer-look, 0); }
                                }
                            }
                            ToolPanel {
                                width: 6 * 68px + 20px + 26px;
                                title: "COLOR";
                                locked: root.meta-locked[1];
                                tool(op) => { root.group-tool(Scope.layer-look, 1, op); }
                                if root.look.length > 17: SwitchCell {
                                    x: 0;
                                    data: root.look[0];
                                    set(k, v) => { root.param-set(Scope.layer-look, 0, k, v); }
                                    grabbed => { root.group-touch(Scope.layer-look, 1); }
                                }
                                for i in [1, 2, 3, 4, 5]: Knob {
                                    x: i * 68px + (68px - self.width) / 2;
                                    data: root.look.length > 17 ? root.look[i] : { name: "", index: -1 };
                                    set(k, v) => { root.param-set(Scope.layer-look, 0, k, v); }
                                    grabbed => { root.group-touch(Scope.layer-look, 1); }
                                }
                            }
                            ToolPanel {
                                width: 2 * 68px + 20px + 26px;
                                title: "MIRROR";
                                locked: root.meta-locked[2];
                                tool(op) => { root.group-tool(Scope.layer-look, 2, op); }
                                for i in [6, 7]: SwitchCell {
                                    x: (i - 6) * 68px;
                                    data: root.look.length > 17 ? root.look[i] : { name: "", index: -1 };
                                    set(k, v) => { root.param-set(Scope.layer-look, 0, k, v); }
                                    grabbed => { root.group-touch(Scope.layer-look, 2); }
                                }
                            }
                            ToolPanel {
                                width: 3 * 68px + 20px + 26px;
                                title: "LIMIT COLORS";
                                locked: root.meta-locked[3];
                                tool(op) => { root.group-tool(Scope.layer-look, 3, op); }
                                if root.look.length > 17: SwitchCell {
                                    x: 0;
                                    data: root.look[8];
                                    set(k, v) => { root.param-set(Scope.layer-look, 0, k, v); }
                                    grabbed => { root.group-touch(Scope.layer-look, 3); }
                                }
                                ColorCell {
                                    x: 68px;
                                    params: root.look;
                                    first: 9;
                                    label: "Low Color";
                                    set(k, v) => { root.param-set(Scope.layer-look, 0, k, v); }
                                    grabbed => { root.group-touch(Scope.layer-look, 3); }
                                }
                                ColorCell {
                                    x: 2 * 68px;
                                    params: root.look;
                                    first: 13;
                                    label: "High Color";
                                    set(k, v) => { root.param-set(Scope.layer-look, 0, k, v); }
                                    grabbed => { root.group-touch(Scope.layer-look, 3); }
                                }
                            }
                            ToolPanel {
                                width: 68px + 20px + 26px;
                                title: "GENERAL";
                                locked: root.meta-locked[4];
                                tool(op) => { root.group-tool(Scope.layer-look, 4, op); }
                                if root.look.length > 17: SwitchCell {
                                    x: 0;
                                    data: root.look[17];
                                    set(k, v) => { root.param-set(Scope.layer-look, 0, k, v); }
                                    grabbed => { root.group-touch(Scope.layer-look, 4); }
                                }
                            }
                        }
                    }

                    // MEDIA: an image, video or camera over the visual, belonging to the layer.
                    RowHeader {
                        title: "MEDIA";
                        tools: false;
                    }
                    HorizontalLayout {
                        height: 190px;
                        spacing: 8px;
                        alignment: start;
                        opacity: root.map-macro >= 0 ? 0.5 : 1;
                        // What plays, its transport and how it mixes in.
                        Rectangle {
                            width: 420px;
                            background: Theme.panel;
                            border-width: 1px;
                            border-color: Theme.separator;
                            border-radius: Theme.radius;
                            Rectangle {
                                x: 10px;
                                y: 10px;
                                width: 72px;
                                height: 72px;
                                background: Theme.track;
                                if root.overlay-has-thumb: Image {
                                    width: parent.width;
                                    height: parent.height;
                                    source: root.overlay-thumb;
                                    image-fit: cover;
                                }
                                if !root.overlay-valid: Text {
                                    text: "none";
                                    color: Theme.text-faint;
                                    font-size: Theme.font-small;
                                }
                            }
                            Text {
                                x: 92px;
                                y: 12px;
                                width: 200px;
                                text: root.overlay-valid ? root.overlay-name : "Pick media below";
                                color: root.overlay-valid ? Theme.text : Theme.text-faint;
                                font-size: Theme.font-normal;
                                font-weight: 600;
                                overflow: elide;
                            }
                            if root.overlay-valid: FlatButton {
                                x: 92px;
                                y: 36px;
                                width: 80px;
                                text: "Remove";
                                clicked => { root.overlay-clear(); }
                            }
                            BlendPicker {
                                x: 300px;
                                y: 10px;
                                width: 110px;
                                modes: root.blend-modes;
                                blend-sections: true;
                                current: root.overlay-blend;
                                picked(i) => { root.overlay-blend-picked(i); }
                            }
                            HorizontalLayout {
                                x: 10px;
                                y: 100px;
                                spacing: 8px;
                                alignment: start;
                                TransportButton {
                                    round: true;
                                    active: root.overlay-playing;
                                    icon: root.overlay-playing ? "M 3.5 2 L 5.5 2 L 5.5 12 L 3.5 12 Z M 8.5 2 L 10.5 2 L 10.5 12 L 8.5 12 Z" : "M 3 1.5 L 12.5 7 L 3 12.5 Z";
                                    clicked => { root.overlay-transport(Transport.play); }
                                }
                                TransportButton {
                                    y: 4px;
                                    icon: "M 2 2 L 4 2 L 4 12 L 2 12 Z M 12 2 L 5 7 L 12 12 Z";
                                    clicked => { root.overlay-transport(Transport.prev); }
                                }
                                TransportButton {
                                    y: 4px;
                                    icon: "M 2 2 L 9 7 L 2 12 Z M 10 2 L 12 2 L 12 12 L 10 12 Z";
                                    clicked => { root.overlay-transport(Transport.next); }
                                }
                                TransportButton {
                                    y: 4px;
                                    icon: "M 3 3 L 11 3 L 11 11 L 3 11 Z";
                                    clicked => { root.overlay-transport(Transport.stop); }
                                }
                                BlendPicker {
                                    y: 9px;
                                    width: 100px;
                                    modes: root.play-modes;
                                    current: root.overlay-play-mode;
                                    picked(i) => { root.overlay-play-mode-picked(i); }
                                }
                            }
                            // Scrub bar.
                            Rectangle {
                                x: 10px;
                                y: 156px;
                                width: 268px;
                                height: 14px;
                                opacity: root.overlay-has-length ? 1 : 0.4;
                                Rectangle {
                                    y: 5px;
                                    height: 4px;
                                    border-radius: 2px;
                                    background: Theme.track;
                                }
                                Rectangle {
                                    y: 5px;
                                    width: parent.width * clamp(root.overlay-progress, 0, 1);
                                    height: 4px;
                                    border-radius: 2px;
                                    background: Theme.accent;
                                }
                                Rectangle {
                                    x: parent.width * clamp(root.overlay-progress, 0, 1) - 3px;
                                    width: 6px;
                                    height: 14px;
                                    border-radius: 2px;
                                    background: Theme.text;
                                }
                                scrub := TouchArea {
                                    enabled: root.overlay-has-length;
                                    mouse-cursor: pointer;
                                    pointer-event(e) => {
                                        if (e.kind == PointerEventKind.down) {
                                            root.overlay-scrub(clamp(self.mouse-x / self.width, 0, 1));
                                        }
                                    }
                                    moved => {
                                        if (self.pressed) {
                                            root.overlay-scrub(clamp(self.mouse-x / self.width, 0, 1));
                                        }
                                    }
                                }
                            }
                            if root.overlay-params.length > 1: Knob {
                                x: 284px;
                                y: 40px;
                                data: root.overlay-params[0];
                                set(k, v) => { root.param-set(Scope.overlay, 0, k, v); }
                            }
                            if root.overlay-params.length > 1: Knob {
                                x: 350px;
                                y: 40px;
                                data: root.overlay-params[1];
                                set(k, v) => { root.param-set(Scope.overlay, 0, k, v); }
                            }
                        }
                        VerticalLayout {
                            spacing: 8px;
                            alignment: start;
                            opacity: root.overlay-valid ? 1 : 0.5;
                            ToolPanel {
                                width: 4 * 68px + 20px + 26px;
                                title: "TRANSFORM";
                                locked: root.media-locked.length > 0 && root.media-locked[0];
                                tool(op) => { root.group-tool(Scope.overlay, 0, op); }
                                if root.overlay-params.length > 5: Knob {
                                    x: (68px - self.width) / 2;
                                    data: root.overlay-params[2];
                                    set(k, v) => { root.param-set(Scope.overlay, 0, k, v); }
                                    grabbed => { root.group-touch(Scope.overlay, 0); }
                                }
                                for i in [3, 4, 5]: SwitchCell {
                                    x: (i - 2) * 68px;
                                    data: root.overlay-params.length > 5 ? root.overlay-params[i] : { name: "", index: -1 };
                                    set(k, v) => { root.param-set(Scope.overlay, 0, k, v); }
                                    grabbed => { root.group-touch(Scope.overlay, 0); }
                                }
                            }
                        }
                        ToolPanel {
                            width: 5 * 68px + 20px + 26px;
                            title: "COLOR";
                            opacity: root.overlay-valid ? 1 : 0.5;
                            locked: root.media-locked.length > 1 && root.media-locked[1];
                            tool(op) => { root.group-tool(Scope.overlay-look, 0, op); }
                            if root.overlay-look.length > 17: SwitchCell {
                                x: 0;
                                data: root.overlay-look[0];
                                set(k, v) => { root.param-set(Scope.overlay-look, 0, k, v); }
                                grabbed => { root.group-touch(Scope.overlay-look, 0); }
                            }
                            for i[n] in [3, 2, 4, 5]: Knob {
                                x: (n + 1) * 68px + (68px - self.width) / 2;
                                data: root.overlay-look.length > 17 ? root.overlay-look[i] : { name: "", index: -1 };
                                set(k, v) => { root.param-set(Scope.overlay-look, 0, k, v); }
                                grabbed => { root.group-touch(Scope.overlay-look, 0); }
                            }
                        }
                    }

                    // The media browser: folders, live sources and thumbnails.
                    Rectangle {
                        height: 34px + 3 * 64px + 8px;
                        background: Theme.panel;
                        border-width: 1px;
                        border-color: Theme.separator;
                        border-radius: Theme.radius;
                        HorizontalLayout {
                            x: 8px;
                            y: 6px;
                            height: 24px;
                            width: parent.width - 16px;
                            spacing: 4px;
                            for c[i] in root.media-chips: Rectangle {
                                width: chip-text.preferred-width + 18px;
                                border-radius: Theme.radius;
                                background: i == root.media-chip ? Theme.accent-dim : chip-ta.has-hover ? Theme.raised : Theme.panel-2;
                                border-width: 1px;
                                border-color: i == root.media-chip ? Theme.accent : Theme.border;
                                chip-text := Text {
                                    text: c;
                                    color: i == root.media-chip ? Theme.accent : Theme.text;
                                    font-size: Theme.font-small;
                                    font-weight: 600;
                                }
                                chip-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.media-chip-picked(i); }
                                    double-clicked => {
                                        if (i >= 2) {
                                            root.media-remove-folder(i);
                                        }
                                    }
                                }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            RowToolButton {
                                op: GroupOp.lock;
                                text: root.media-browser-locked ? "locked" : "lock";
                                active: root.media-browser-locked;
                                clicked => { root.media-lock(); }
                            }
                            RowToolButton {
                                op: GroupOp.undo;
                                text: "refresh";
                                clicked => { root.media-refresh(); }
                            }
                            FlatButton {
                                text: "+ add folder";
                                clicked => { root.media-add-folder(); }
                            }
                        }
                        if root.media-items.length == 0: Text {
                            y: 34px;
                            height: parent.height - 40px;
                            width: parent.width;
                            text: root.media-chip == 1 ? "No cameras or Syphon servers found" : "Add a folder of images or videos";
                            color: Theme.text-faint;
                            font-size: Theme.font-body;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        grid := ScrollView {
                            x: 8px;
                            y: 34px;
                            width: parent.width - 16px;
                            height: parent.height - 40px;
                            property <int> cols: max(1, floor((self.visible-width) / 108px));
                            content-height: ceil(root.media-items.length / self.cols) * 64px;
                            for t[i] in root.media-items: Rectangle {
                                x: mod(i, grid.cols) * 108px;
                                y: floor(i / grid.cols) * 64px;
                                width: 104px;
                                height: 60px;
                                background: Theme.track;
                                border-width: t.current ? 2px : tile-ta.has-hover ? 1px : 0;
                                border-color: t.current ? Theme.accent : Theme.text-dim;
                                if t.has-thumb: Image {
                                    x: 2px;
                                    y: 2px;
                                    width: parent.width - 4px;
                                    height: parent.height - 4px;
                                    source: t.thumb;
                                    image-fit: cover;
                                }
                                if !t.has-thumb: Text {
                                    width: parent.width - 8px;
                                    text: t.name;
                                    color: t.kind == "camera" ? Theme.camera : t.kind == "syphon" ? Theme.syphon : Theme.text-dim;
                                    font-size: Theme.font-tiny;
                                    horizontal-alignment: center;
                                    wrap: word-wrap;
                                    overflow: elide;
                                }
                                tile-ta := TouchArea {
                                    mouse-cursor: root.media-browser-locked ? not-allowed : pointer;
                                    clicked => { root.overlay-pick(i); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
